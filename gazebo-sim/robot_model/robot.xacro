<?xml version="1.0"?>

<robot name="lunabotics" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:property name="pi" value="3.14159265"/>

    <xacro:property name="a" value="1"/>
    <xacro:property name="b" value="0.3"/>
    <xacro:property name="c" value="0.6"/>

    <xacro:property name="r" value="0.15"/>
    <xacro:property name="d" value="0.1"/>

    <xacro:property name="density_body" value="2710.0"/>
    <xacro:property name="density_wheel" value="2710.0"/>
    <xacro:property name="density_caster_wheel" value="2710.0"/>

    <xacro:property name="s1" value="${b/2+r}"/>
    <xacro:property name="s2" value="${2*r}"/>
    <xacro:property name="s3" value="${2*r}"/>
    <xacro:property name="s4" value="${c/2+d/2}"/>

    <xacro:property name="m1" value="${d1*a*b*c}"/>
    <xacro:property name="m2" value="${d2*pi*r*r*d}"/>
    <xacro:property name="m3" value="${d3*(4.0/3.0)*pi*r*r*r}"/>

    <xacro:property name="moi_x_body" value="${(1.0/12.0)*m1*(b*b+c*c)}"/>
    <xacro:property name="moi_y_body" value="${(1.0/12.0)*m1*(a*a+b*b)}"/>
    <xacro:property name="moi_z_body" value="${(1.0/12.0)*m1*(a*a+c*c)}"/>

    <xacro:property name="moi_wheel" value="${0.5*m2*r*r}"/>
    <xacro:property name="moi_z_wheel" value="${(1.0/2.0)*m2*(3.0*r*r+d*d)}"/>

    <xacro:property name="moi_caster" value="${(2.0/5.0)*m3*r*r}"/>

    <xacro:macro name="inertia_body">
        <inertial>
            <origin xyz="0 0 ${s1}" rpy="0 0 0"/>
            <mass value="${m1}"/>
            <inertia ixx="${moi_x_body}" ixy="0" ixz="0" iyy="${moi_y_body}" iyz="0" izz="${moi_z_body}"/>
        </inertial>
    </xacro:macro>

    <xacro:macro name="inertia_wheel">
        <inertial>
            <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
            <mass value="${m2}"/>
            <inertia ixx="${moi_wheel}" ixy="0" ixz="0" iyy="${moi_wheel}" iyz="0" izz="${moi_z_wheel}"/>
        </inertial>
    </xacro:macro>

    <xacro:macro name="inertia_caster_wheel">
        <inertial>
            <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
            <mass value="${m3}"/>
            <inertia ixx="${moi_caster}" ixy="0" ixz="0" iyy="${moi_caster}" iyz="0" izz="${moi_caster}"/>
        </inertial>
    </xacro:macro>

    <xacro:include filename="$(find lunabotics)/model/robot.gazebo"/>

    <link name="base_footprint"/>

    <joint name="body_link_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="body_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="body_link">
        <visual>
            <origin xyz="0 0 ${s1}" rpy="0 0 0"/>
            <geometry>
                <box size="${body_length} ${body_width} ${body_height}"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 ${s1}" rpy="0 0 0"/>
            <geometry>
                <box size="${body_length} ${body_width} ${body_height}"/>
            </geometry>
        </collision>
        <xacro:inertia_body/>
    </link>

    <xacro:macro name="drive_wheel" params="name x y">
        <joint name="${name}_joint" type="continuous">
            <parent link="body_link"/>
            <child link="${name}_link"/>
            <origin xyz="${x} ${y} ${wheel_radius}" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
            <limit effort="50000" velocity="10"/>
            <dynamics damping="1.0" friction="1.0"/>
        </joint>

        <link name="${name}_link">
            <visual>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
            </collision>
            <xacro:inertia_wheel/>
        </link>
    </xacro:macro>

    <xacro:drive_wheel name="wheel1" x="${-s2}" y="${-s4}"/>
    <xacro:drive_wheel name="wheel2" x="${-s2}" y="${s4}"/>
    <xacro:drive_wheel name="wheel3" x="${s3}" y="${-s4}"/>
    <xacro:drive_wheel name="wheel4" x="${s3}" y="${s4}"/>

    <joint name="caster_wheel_joint" type="continuous">
        <parent link="body_link"/>
        <child link="caster_wheel_link"/>
        <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit effort="100" velocity="20"/>
        <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <link name="caster_wheel_link">
        <visual>
            <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
            </geometry>
        </collision>
        <xacro:inertia_caster_wheel/>
    </link>
</robot>
